# Build artifacts
*.exe
phase*test
srv
p9

# ...but phase*test source directories ARE tracked — the pattern above was
# meant for compiled test binaries (go build -o phase9test), not the
# cmd/phaseNtest/ sources. Without these negations the integration-test
# sources were invisible to git.
!cmd/phase1test/
!cmd/phase2test/
!cmd/phase3test/
!cmd/phase4test/
!cmd/phase5test/
!cmd/phase6test/
!cmd/phase7test/
!cmd/phase8test/
!cmd/phase9test/
!cmd/phase10test/

